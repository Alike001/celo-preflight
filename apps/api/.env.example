PORT=3001
CELO_RPC_URL=https://forno.celo.org
CELO_SEPOLIA_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
DATA_DIR=.data

# Exact organizer-assigned ERC-8021 code. Without it, reports truthfully mark Track 1 credit as unproven.
REQUIRED_ATTRIBUTION_TAG=

# Celo's hosted facilitator requires an API key for every settlement. Create it
# at https://x402.celo.org by signing a message (no gas); never commit the key.
X402_FACILITATOR_URL=https://api.x402.celo.org
X402_FACILITATOR_API_KEY=
X402_PAY_TO=
X402_PRICE=$0.01

# Use a dedicated unfunded key locally. Production must inject a dedicated report signer.
REPORT_SIGNER_PRIVATE_KEY=

# Optional standalone Celo Sepolia fee-currency verifier. These values are never used by the app.
# Keep a dedicated TESTNET key only in your local shell; do not add it to Railway or Git.
CELO_SEPOLIA_FEE_TEST_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_SEPOLIA_FEE_TEST_ADDRESS=
CELO_SEPOLIA_FEE_TEST_PRIVATE_KEY=
CELO_SEPOLIA_FEE_TEST_RECIPIENT=
# Both caps are USDC base units (6 decimals); they are required only with --broadcast.
CELO_SEPOLIA_FEE_TEST_USDC_AMOUNT=
CELO_SEPOLIA_FEE_TEST_MAX_FEE_USDC=
